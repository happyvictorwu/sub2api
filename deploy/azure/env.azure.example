# =============================================================================
# Sub2API on Azure - 环境变量模板
# =============================================================================
# 这个文件只放在 VM 的 /opt/sub2api/.env，不要提交到 Git。
# 首次部署时由 deploy/azure/bootstrap.sh 自动生成随机密钥并写到 VM 上。
# =============================================================================

# -----------------------------------------------------------------------------
# 镜像与站点地址
# -----------------------------------------------------------------------------
# CI 推送到 GHCR 的镜像，部署时由 GitHub Actions 覆盖成带 commit SHA 的具体标签
APP_IMAGE=ghcr.io/happyvictorwu/sub2api:latest

# Azure 默认域名（bootstrap 会自动填好），之后换自有域名只需改这两行并重启
SITE_ADDRESS=sub2api-example.southeastasia.cloudapp.azure.com
SITE_URL=https://sub2api-example.southeastasia.cloudapp.azure.com

# Let's Encrypt 证书到期提醒邮箱（可留空）
ACME_EMAIL=

# -----------------------------------------------------------------------------
# 网络绑定：应用端口只监听回环，公网流量统一由 Caddy 处理
# -----------------------------------------------------------------------------
BIND_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard

# -----------------------------------------------------------------------------
# 时区（影响统计口径、订阅到期时间、日志时间）
# -----------------------------------------------------------------------------
TZ=Asia/Singapore

# -----------------------------------------------------------------------------
# PostgreSQL（跑在同一台 VM 的容器里，不对外暴露端口）
# -----------------------------------------------------------------------------
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# 4 GiB 内存机型的保守调优值
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# -----------------------------------------------------------------------------
# Redis（同机容器，不对外暴露端口）
# -----------------------------------------------------------------------------
# openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=10

# -----------------------------------------------------------------------------
# 管理员账号（仅首次启动、数据库为空时创建）
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
# 首次登录后请立刻改密码
ADMIN_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# 安全密钥：务必固定，否则每次重启都会导致登录失效 / 2FA 失效
# openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# 数据库连接池
# -----------------------------------------------------------------------------
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# -----------------------------------------------------------------------------
# 可选项
# -----------------------------------------------------------------------------
# 在线更新 / 价格数据访问 GitHub 用的代理
UPDATE_PROXY_URL=
# 提高 GitHub API 速率限制用的只读 token
UPDATE_GITHUB_TOKEN=
# Gemini OAuth（需要接 Gemini 账号时再填）
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
