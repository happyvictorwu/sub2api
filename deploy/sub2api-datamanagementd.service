[Unit]
Description=Slothwatching Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=slothwatching
Group=slothwatching
WorkingDirectory=/opt/slothwatching
ExecStart=/opt/slothwatching/datamanagementd \
  -socket-path /tmp/slothwatching-datamanagement.sock \
  -sqlite-path /var/lib/slothwatching/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
